# Шаблон для backend/.env НА СЕРВЕРЕ staging. Копируется туда вручную при
# бутстрапе сервера (см. README "Staging и деплой") и заполняется реальными
# секретами — сам файл в репозиторий не попадает (см. .gitignore).
#
# POSTGRES_PASSWORD и пароль в DATABASE_URL должны совпадать — Postgres
# берёт пароль из POSTGRES_PASSWORD при первом создании базы, Django — из
# DATABASE_URL при каждом подключении.

DJANGO_SETTINGS_MODULE=config.settings.production
DJANGO_SECRET_KEY=сгенерировать-реальный-секрет-не-дефолтный
DJANGO_DEBUG=false
# Реальный домен staging, когда появится хостинг (ADR-002, открытый вопрос).
DJANGO_ALLOWED_HOSTS=staging.kidscrm.example

POSTGRES_PASSWORD=сгенерировать-реальный-пароль
DATABASE_URL=postgres://kidscrm:сгенерировать-реальный-пароль@db:5432/kidscrm
REDIS_URL=redis://redis:6379/0
