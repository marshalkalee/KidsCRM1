DJANGO_SETTINGS_MODULE=config.settings.local
DJANGO_SECRET_KEY=change-me-in-every-environment
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# "db"/"redis" — имена сервисов в docker-compose.yml, а не localhost:
# backend сам работает в контейнере и ходит к ним по внутренней сети.
# Если запускаешь Django не в Docker (редкий случай, например ради
# автодополнения в IDE) — замени на localhost:5433 и localhost:6379.
DATABASE_URL=postgres://kidscrm:kidscrm@db:5432/kidscrm
REDIS_URL=redis://redis:6379/0
