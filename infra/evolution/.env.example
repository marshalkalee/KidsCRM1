# Evolution API — сервер WhatsApp-номеров по QR-коду (docs/whatsapp-evolution.md).
# На сервере: cp infra/evolution/.env.example infra/evolution/.env и заполнить.
# Полный список переменных — .env.example в репозитории evolution-api (тег 2.3.7).

SERVER_TYPE=http
SERVER_PORT=8080
# Адрес, которым Evolution подписывает события; снаружи он не открыт.
SERVER_URL=http://evolution:8080

# Общий ключ доступа. Тот же — в backend/.env как EVOLUTION_API_KEY.
# Сгенерировать: openssl rand -hex 32
AUTHENTICATION_API_KEY=сгенерировать-ключ
AUTHENTICATION_EXPOSE_IN_FETCH_INSTANCES=false

# Отдельная база "evolution" в том же Postgres (создать один раз:
# docker compose -f docker-compose.staging.yml exec db createdb -U kidscrm evolution).
# Пароль — тот же POSTGRES_PASSWORD, что в backend/.env.
DATABASE_PROVIDER=postgresql
DATABASE_CONNECTION_URI=postgresql://kidscrm:пароль-postgres@db:5432/evolution?schema=public
DATABASE_CONNECTION_CLIENT_NAME=kidscrm

# Переписки родителей храним только в CRM: Evolution держит у себя лишь
# сессию номера, без сообщений, чатов и контактов.
DATABASE_SAVE_DATA_INSTANCE=true
DATABASE_SAVE_DATA_NEW_MESSAGE=false
DATABASE_SAVE_MESSAGE_UPDATE=false
DATABASE_SAVE_DATA_CONTACTS=false
DATABASE_SAVE_DATA_CHATS=false
DATABASE_SAVE_DATA_LABELS=false
DATABASE_SAVE_DATA_HISTORIC=false

CACHE_REDIS_ENABLED=true
CACHE_REDIS_URI=redis://redis:6379/6
CACHE_REDIS_PREFIX_KEY=evolution
CACHE_REDIS_SAVE_INSTANCES=false
CACHE_LOCAL_ENABLED=false

# Не отправлять статистику разработчикам Evolution, не открывать /metrics.
TELEMETRY_ENABLED=false
PROMETHEUS_METRICS=false

# Не удалять номер, если QR долго не сканируют, — это решает CRM.
DEL_INSTANCE=false
# Так подключение выглядит в WhatsApp → «Связанные устройства».
CONFIG_SESSION_PHONE_CLIENT=KidsCRM
CONFIG_SESSION_PHONE_NAME=Chrome
QRCODE_LIMIT=30

# Глобальный вебхук не нужен: у каждого номера свой адрес с секретом.
WEBHOOK_GLOBAL_ENABLED=false
WEBHOOK_REQUEST_TIMEOUT_MS=30000
WEBHOOK_RETRY_MAX_ATTEMPTS=10

# Лишние интеграции выключены.
RABBITMQ_ENABLED=false
SQS_ENABLED=false
WEBSOCKET_ENABLED=false
CHATWOOT_ENABLED=false
TYPEBOT_ENABLED=false
OPENAI_ENABLED=false
DIFY_ENABLED=false
S3_ENABLED=false

LANGUAGE=en
LOG_LEVEL=ERROR,WARN,INFO
LOG_BAILEYS=error
